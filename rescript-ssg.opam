opam-version: "2.0"
name: "rescript-ssg"
synopsis: "Rescript React static site generator"
maintainer: "Denis Strelkov <strelkov.d.d@gmail.com>"
authors: "Denis Strelkov <strelkov.d.d@gmail.com>"
homepage: "https://github.com/denis-ok/rescript-ssg/"
doc: "https://github.com/denis-ok/rescript-ssg/"
bug-reports: "https://github.com/denis-ok/rescript-ssg/issues"
dev-repo: "git+https://github.com/denis-ok/rescript-ssg.git"
depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "5.1.0"}
  "melange" {>= "3.0.0"}
  "reason" {>= "3.11.0"}
  "reason-react" {>= "0.14.0"}
  "reason-react-ppx"
  "server-reason-react"
  "styled-ppx" # only used for the example
  "ocaml-lsp-server" {with-test} # todo: use with-dev-setup once opam 2.2 is out
  "ocamlformat" {with-test} # todo: use with-dev-setup once opam 2.2 is out
  "opam-check-npm-deps" {with-test} # todo: use with-dev-setup once opam 2.2 is out
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
pin-depends: [
  ["server-reason-react.dev" "https://github.com/ml-in-barcelona/server-reason-react/archive/3f98927ab95283edf1d916e50313bfc31a1a56e8.tar.gz"]
  ["styled-ppx.dev" "https://github.com/davesnx/styled-ppx/archive/2fd57cd270505eb7adabcd2d9afd47e2d29560b0.tar.gz"]
]
