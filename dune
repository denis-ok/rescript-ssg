 (package rescript-ssg)
 (files
  (glob_files ssgbin/node_modules/melange/*.mjs)
  (glob_files ssgbin/node_modules/melange.belt/*.mjs)
  (glob_files ssgbin/node_modules/melange.dom/*.mjs)
  (glob_files ssgbin/node_modules/melange.js/*.mjs)
  (glob_files ssgbin/node_modules/reason-react/*.mjs)
  (glob_files ssgbin/node_modules/rescript-ssg/*.mjs)
  (glob_files ssgbin/node_modules/rescript-ssg/bindings/*.mjs)))

(install
